<script>
  // Mobile nav toggle
  var hamburger = document.getElementById('hamburger');
  var navLinks = document.getElementById('navLinks');
  hamburger.addEventListener('click', function(){
    navLinks.classList.toggle('open');
    var expanded = navLinks.classList.contains('open');
    hamburger.setAttribute('aria-expanded', expanded);
  });
  document.querySelectorAll('.nav-links a').forEach(function(a){
    a.addEventListener('click', function(){ navLinks.classList.remove('open'); });
  });

  // Live time zone bridge
  function pad(n){ return n < 10 ? '0'+n : n; }
  function updateClocks(){
    var now = new Date();
    var usFmt = new Intl.DateTimeFormat('en-US', {timeZone:'America/New_York', hour:'2-digit', minute:'2-digit', hour12:false});
    var boFmt = new Intl.DateTimeFormat('en-US', {timeZone:'America/La_Paz', hour:'2-digit', minute:'2-digit', hour12:false});
    document.getElementById('clockUS').textContent = usFmt.format(now);
    document.getElementById('clockBO').textContent = boFmt.format(now);

    var usHourFmt = new Intl.DateTimeFormat('en-US', {timeZone:'America/New_York', hour:'numeric', hour12:false, timeZoneName:'short'});
    var boHourFmt = new Intl.DateTimeFormat('en-US', {timeZone:'America/La_Paz', hour:'numeric', hour12:false, timeZoneName:'short'});
    // Compute offset difference in hours using date parts
    var usParts = new Intl.DateTimeFormat('en-US', {timeZone:'America/New_York', hourCycle:'h23', year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'}).formatToParts(now);
    var boParts = new Intl.DateTimeFormat('en-US', {timeZone:'America/La_Paz', hourCycle:'h23', year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'}).formatToParts(now);
    function toMap(parts){ var o={}; parts.forEach(function(p){ o[p.type]=p.value; }); return o; }
    var u = toMap(usParts), b = toMap(boParts);
    var usDate = new Date(u.year, u.month-1, u.day, u.hour, u.minute);
    var boDate = new Date(b.year, b.month-1, b.day, b.hour, b.minute);
    var diffHours = Math.round((boDate - usDate) / 3600000);
    var label = diffHours === 0 ? 'Same time' : (Math.abs(diffHours) + ' hr' + (Math.abs(diffHours)>1?'s':''));
    document.getElementById('diffLabel').textContent = label;
  }
  updateClocks();
  setInterval(updateClocks, 30000);
</script>

